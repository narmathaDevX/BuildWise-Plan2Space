# Plan2Space 3D Configuration
PROJECT_NAME="Plan2Space 3D"
VERSION="1.0.0"
API_PREFIX="/api/v1"

# Storage Directories
DATA_DIR=data
UPLOADS_DIR=data/uploads
MODELS_DIR=data/models
JOBS_DIR=data/jobs

# OCR Feature (Optional)
ENABLE_OCR=false

# Geometry Defaults (metres)
DEFAULT_WALL_HEIGHT=2.7
DEFAULT_EXTERIOR_WALL_THICKNESS=0.23
DEFAULT_INTERIOR_WALL_THICKNESS=0.115
DEFAULT_FLOOR_THICKNESS=0.15

# Security & CORS
API_KEY=
CORS_ORIGINS=["*"]
